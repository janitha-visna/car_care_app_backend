erDiagram
    CUSTOMER {
        int id PK
        string phone_number
        string name
        datetime created_at
    }

    VEHICLE {
        int id PK
        string vehicle_number
        int vehicle_type_id FK
        int current_customer_id FK
        datetime created_at
    }

    VEHICLE_TYPE {
        int id PK
        string name
        boolean is_active
    }

    BASE_SERVICE_TYPE {
        int id PK
        string name
        boolean is_active
    }

    INVENTORY_ITEM {
        int id PK
        string name
        string unit
        boolean is_tracked_in_stock
        decimal reorder_threshold
        boolean is_active
    }

    BASE_SERVICE_PRICE_HISTORY {
        int id PK
        int base_service_type_id FK
        decimal price
        date effective_from
        date effective_to
        int created_by FK
        datetime created_at
    }

    INVENTORY_ITEM_PRICE_HISTORY {
        int id PK
        int inventory_item_id FK
        decimal price
        date effective_from
        date effective_to
        int created_by FK
        datetime created_at
    }

    SERVICE_RECORD {
        int id PK
        int vehicle_id FK
        int customer_id FK
        date service_date
        int base_service_type_id FK
        decimal base_service_price_applied
        decimal calculated_total
        decimal charged_total
        int operator_id FK
        string status
        datetime created_at
        datetime updated_at
    }

    SERVICE_RECORD_ITEM {
        int id PK
        int service_record_id FK
        int inventory_item_id FK
        decimal quantity
        decimal unit_price_applied
        decimal line_total
    }

    STOCK_MOVEMENT {
        int id PK
        int inventory_item_id FK
        decimal quantity_delta
        string reason
        int reference_service_record_id FK
        int reference_purchase_id FK
        int created_by FK
        datetime created_at
    }

    STOCK_PURCHASE {
        int id PK
        int inventory_item_id FK
        decimal quantity
        decimal unit_cost
        string supplier
        date purchase_date
        int created_by FK
    }

    ELECTRICITY_READING {
        int id PK
        date reading_month
        decimal meter_reading
        int recorded_by FK
        datetime recorded_at
        string notes
    }

    USER {
        int id PK
        string name
        string role
        boolean is_active
    }

    CUSTOMER ||--o{ VEHICLE : "currently owns"
    VEHICLE_TYPE ||--o{ VEHICLE : "categorizes"
    VEHICLE ||--o{ SERVICE_RECORD : "has"
    CUSTOMER ||--o{ SERVICE_RECORD : "billed to"
    BASE_SERVICE_TYPE ||--o{ SERVICE_RECORD : "selected as"
    BASE_SERVICE_TYPE ||--o{ BASE_SERVICE_PRICE_HISTORY : "has price history"
    USER ||--o{ BASE_SERVICE_PRICE_HISTORY : "recorded by"

    INVENTORY_ITEM ||--o{ INVENTORY_ITEM_PRICE_HISTORY : "has price history"
    USER ||--o{ INVENTORY_ITEM_PRICE_HISTORY : "recorded by"

    SERVICE_RECORD ||--o{ SERVICE_RECORD_ITEM : "line items"
    INVENTORY_ITEM ||--o{ SERVICE_RECORD_ITEM : "used in"
    USER ||--o{ SERVICE_RECORD : "operated by"

    INVENTORY_ITEM ||--o{ STOCK_MOVEMENT : "tracked by"
    SERVICE_RECORD ||--o| STOCK_MOVEMENT : "triggers"
    STOCK_PURCHASE ||--o| STOCK_MOVEMENT : "triggers"
    USER ||--o{ STOCK_MOVEMENT : "recorded by"

    INVENTORY_ITEM ||--o{ STOCK_PURCHASE : "restocked via"
    USER ||--o{ STOCK_PURCHASE : "recorded by"

    USER ||--o{ ELECTRICITY_READING : "recorded by"
